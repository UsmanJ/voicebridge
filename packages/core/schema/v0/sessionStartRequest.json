{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sessionRef": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,256}$"
    },
    "runtimeBinding": {
      "type": "object",
      "properties": {
        "runtime": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "roomName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        }
      },
      "required": [
        "runtime",
        "roomName"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "sessionRef"
  ],
  "additionalProperties": false,
  "$id": "https://voicebridge.dev/schema/v0/sessionStartRequest.json",
  "title": "sessionStartRequest",
  "description": "VoiceBridge wire contract v0 (experimental): sessionStartRequest"
}
