{
  "name": "@voicebridge/runtime-livekit",
  "version": "0.0.0",
  "description": "VoiceBridge runtime adapter for LiveKit Agents (Node.js). Backend-controlled mode: verified sessions, STT and TTS, backend-approved replies spoken verbatim. No LLM.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@voicebridge/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@voicebridge/core": "workspace:*",
    "@voicebridge/livekit-tokens": "workspace:*"
  },
  "peerDependencies": {
    "@livekit/agents": "~1.9.5"
  },
  "devDependencies": {
    "@livekit/agents": "1.9.5",
    "@livekit/rtc-node": "0.13.35",
    "@types/node": "^24.13.5",
    "livekit-server-sdk": "^2.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
