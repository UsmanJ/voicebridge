{
  "name": "@voicebridge/livekit-tokens",
  "version": "0.1.0-alpha.1",
  "description": "Server-side LiveKit participant credentials for VoiceBridge: least-privilege, room-scoped, short-lived tokens with allowlisted agent dispatch. No agents runtime, no frontend code.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@voicebridge/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@voicebridge/core": "workspace:*",
    "livekit-server-sdk": "^2.19.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
