{
  "name": "@voicebridge/backend-help-desk-example",
  "version": "0.0.0",
  "description": "Example VoiceBridge application backend: a deterministic, fictional help-desk knowledge service implementing wire contract v0, with server-side session binding. Demo only.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@voicebridge/source": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=../../.env.local --env-file-if-exists=../.env.local src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@voicebridge/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
