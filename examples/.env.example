# VoiceBridge examples: local development configuration (DEMO ONLY).
# Copy to examples/.env.local (gitignored) and fill in. LiveKit credentials (LIVEKIT_URL,
# LIVEKIT_API_KEY, LIVEKIT_API_SECRET) are read from the repository's root .env.local.
#
# Generate each credential with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"

# Application served by all three components (server-side configuration, never from browsers)
VB_APPLICATION_ID=help-desk
VB_AGENT_NAME=voicebridge-help-desk
VB_TEXT_INPUT=true

# Help-desk backend
HELP_DESK_URL=http://127.0.0.1:8788
HELP_DESK_WORKER_CREDENTIAL=
HELP_DESK_HOST_CREDENTIAL=

# Host token route (development identity: localhost only, refused when NODE_ENV=production)
VB_DEV_AUTH=localhost
HOST_ALLOWED_ORIGINS=http://localhost:3000

# Worker providers (LiveKit Inference model ids)
VB_STT_MODEL=assemblyai/universal-3-6-pro
VB_TTS_MODEL=fishaudio/s2.1-pro
