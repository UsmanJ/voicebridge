# VoiceBridge browser demo (DEMO ONLY). Optional: copy to examples/web/.env.local (gitignored).
# Public, build-time value: it is compiled into the browser bundle. Never put secrets here.
#
# The host token route the browser calls. Default: http://127.0.0.1:8790/api/voice/token
# Must be https, or http only on localhost. No credentials, query string, or fragment.
NEXT_PUBLIC_VB_TOKEN_ENDPOINT=

# Extra Content-Security-Policy connect-src origins, space-separated (for example a self-hosted
# LiveKit server). LiveKit Cloud (*.livekit.cloud) is already allowed.
VB_WEB_EXTRA_CONNECT_SRC=
