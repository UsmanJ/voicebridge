{
  "name": "@voicebridge/web-example",
  "version": "0.0.0",
  "description": "Example VoiceBridge browser client (Next.js) for the Pebblebrook help-desk demo. Demo only.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname localhost --port 3000",
    "build": "next build && node scripts/check-bundle.mjs",
    "start": "next start --hostname localhost --port 3000",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@livekit/components-react": "2.9.24",
    "livekit-client": "2.23.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "29.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
